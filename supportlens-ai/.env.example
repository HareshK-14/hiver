# SupportLens AI — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to source control.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── LLM Provider (OpenAI-compatible) ────────────────────────────────────────
# The system uses a provider abstraction. Set the provider here.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Retrieval ───────────────────────────────────────────────────────────────
EMBEDDINGS_MODEL=text-embedding-3-small
INDEX_PATH=./data/processed/index.json

# ── Data ────────────────────────────────────────────────────────────────────
# Set the target brand (determined in Phase 3)
TARGET_BRAND=
DATASET_PATH=./data/raw/

# ── Evaluation ──────────────────────────────────────────────────────────────
GOLDEN_SET_PATH=./evaluation/golden_set.csv
